# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the portfolio (api + web).
#
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Production secrets belong in your deployment's secret
# store (or a root-owned .env file on the server) — see docs/environment.md.
#
# Legend:  [required]  [optional]  [dev-only]  [prod-only]  [prod: required]
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# [required] development | test | production
NODE_ENV=development
# [prod: required] Public origin of the site. Used for CSRF origin checks,
# canonical URLs, links in emails. Must be https in production.
APP_URL=http://localhost:3000
# [prod: required] 32+ random characters. Signs contact-form tokens and keys
# IP hashing. Generate with:  openssl rand -base64 48
APP_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Web (Next.js) ────────────────────────────────────────────────────────────
# [required] Canonical site URL embedded in metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [required] How the Next.js server reaches the API (server-side fetches and
# the /api, /media and /cv rewrites). In Docker: http://api:4000
API_INTERNAL_URL=http://localhost:4000

# ── API (Express) ────────────────────────────────────────────────────────────
# [optional] Bind address and port (defaults 0.0.0.0:4000).
HOST=0.0.0.0
PORT=4000
# [optional] Express "trust proxy" setting. Default trusts loopback and private
# networks (Docker/Caddy). Set a hop count (e.g. 1) behind a single public proxy.
TRUST_PROXY=loopback, linklocal, uniquelocal
# [optional] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=

# ── Database ────────────────────────────────────────────────────────────────
# [required] PostgreSQL 16 connection string.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
# [optional] Connection pool size (default 10).
DATABASE_POOL_MAX=10
# [optional] disable | require | no-verify  (TLS to a managed database).
DATABASE_SSL=disable
# [dev-only] Used by docker-compose.yml for the bundled database container.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio

# ── Authentication & sessions ───────────────────────────────────────────────
# [optional] Absolute session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# [optional] Sign-out after this many idle hours (default 12).
SESSION_IDLE_TIMEOUT_HOURS=12
# [optional] Defaults to true in production. Only set false for plain-http
# local testing. When true the cookie is named __Host-portfolio_session.
COOKIE_SECURE=
# [optional] Failed logins before a temporary lock, and lock length.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── First admin account (used by `npm run db:seed` only) ────────────────────
# [prod: required for first seed] The seed creates this account only when no
# users exist. In development a random password is printed if left empty.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Ibrahim All-Mamun

# ── Storage (uploads) ───────────────────────────────────────────────────────
# [optional] Directory for uploaded media (default ./uploads relative to the
# API working directory; /app/uploads in Docker — mount a volume there).
UPLOAD_DIR=uploads
# [optional] Upload size limits in megabytes.
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=20
UPLOAD_MAX_VIDEO_MB=100

# ── Email (optional) ─────────────────────────────────────────────────────────
# [optional] SMTP for contact notifications and password-reset emails. When
# unset, messages are still stored and reset links are only logged in
# development. MAIL_FROM is required when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── GitHub integration (optional) ───────────────────────────────────────────
# [optional] Token raises the GitHub API rate limit; public data works without.
# Use a fine-grained token with no extra permissions (public repositories only).
GITHUB_TOKEN=
# [optional] Minutes between automatic syncs when enabled in Site settings.
GITHUB_SYNC_INTERVAL_MINUTES=360

# ── Web revalidation ────────────────────────────────────────────────────────
# [required] How the API reaches the Next.js server to refresh cached pages
# after content changes. In Docker: http://web:3000
WEB_INTERNAL_URL=http://localhost:3000
# [required] Shared secret between api and web for /internal/revalidate.
REVALIDATE_SECRET=replace-with-another-long-random-string

# ── Analytics (optional) ────────────────────────────────────────────────────
# [optional] Header set by your CDN/proxy with a two-letter country code
# (e.g. cf-ipcountry). Leave empty to record no country.
ANALYTICS_COUNTRY_HEADER=

# ── Background jobs ─────────────────────────────────────────────────────────
# [optional] In-process scheduler (GitHub sync, retention, session cleanup).
JOBS_ENABLED=true

# ── Production (docker-compose.prod.yml) ────────────────────────────────────
# [prod-only] Domain served by Caddy (automatic HTTPS) and ACME contact email.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
